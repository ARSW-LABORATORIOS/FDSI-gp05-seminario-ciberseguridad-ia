# Perfil para el modelo local en la GPU (RTX 4050): no hay costo ni límite del proveedor; lo que se
# protege es la capacidad de la GPU, que atiende pocas preguntas a la vez.
#   docker compose --env-file .env --env-file perfiles/ollama.env -f docker-compose.yml -f docker-compose.gpu.yml --profile ollama up -d
LITELLM_CONFIG=config.ollama.yaml
TOKEN_RESERVE_PER_QUESTION=1300
QUOTA_TOKENS_SESSION=28000
QUOTA_TOKENS_IP_DAY=107000
QUOTA_TOKENS_GLOBAL_DAY=330000
QUOTA_TOKENS_IP_AHORRO=3900
# Sin esto, en T04 los atacantes llenaban las colas y un estudiante solo obtuvo 1 respuesta de 3.
# Los límites por sesión casi no actúan aquí: la espera en cola frena a los atacantes antes de que
# disparen el de ráfagas, así que el freno tiene que estar en lo que llega a la GPU.
LLM_RPM_GLOBAL=30
LLM_RPM_POR_IP=4
SPIKE_MAX_REQUESTS=3
SPIKE_WINDOW_SECONDS=30
MAX_CONCURRENT_LLM=2
LLM_SLOT_WAIT_SECONDS=20
PRECIO_ENTRADA_USD_1M=0
PRECIO_SALIDA_USD_1M=0
