# Perfil sin modelo real: las mismas cuotas que con Gemini, sin límite por minuto del proveedor.
# Los precios son los de Gemini solo para proyectar cuánto costaría ese tráfico (estimación).
LITELLM_CONFIG=config.mock.yaml
TOKEN_RESERVE_PER_QUESTION=1200
QUOTA_TOKENS_SESSION=23000
QUOTA_TOKENS_IP_DAY=86000
QUOTA_TOKENS_GLOBAL_DAY=260000
QUOTA_TOKENS_IP_AHORRO=3600
LLM_RPM_GLOBAL=0
LLM_RPM_POR_IP=0
SPIKE_MAX_REQUESTS=3
SPIKE_WINDOW_SECONDS=30
MAX_CONCURRENT_LLM=4
PRECIO_ENTRADA_USD_1M=0.30
PRECIO_SALIDA_USD_1M=2.50
