# Perfil para Gemini en capa gratuita: 15 llamadas por minuto y 500 al día (gemini-3.5-flash-lite).
#   docker compose --env-file .env --env-file perfiles/gemini.env up -d --build
# Para que funcione el respaldo con el modelo local, agregar --profile ollama.
#
# Cuotas calculadas por pruebas/calibrar.py con 30 preguntas reales (tokens por pregunta: mediana
# 428, p95 734, máximo 763) y estos supuestos: 40 estudiantes, 10 preguntas al día cada uno, 30 por
# sesión, 20 detrás de una misma IP. Los supuestos no están medidos: cámbienlos si conocen el curso.
LITELLM_CONFIG=config.gemini.yaml
# el mayor costo posible de una pregunta: entrada máxima * 1,2 + tope de salida (300)
TOKEN_RESERVE_PER_QUESTION=1200
# 30 preguntas * p95
QUOTA_TOKENS_SESSION=23000
# 20 estudiantes * 10 preguntas * mediana
QUOTA_TOKENS_IP_DAY=86000
# El menor entre el uso esperado (40 estudiantes * 10 preguntas * mediana * 1,5 = 260.000) y lo que
# Google deja gastar al día (500 llamadas * mediana = 214.000). A precio de lista, unos 0,08 dólares al
# día. El modo de ahorro entra al 80 %: unas 400 preguntas, justo el uso esperado, y deja 100 de reserva.
QUOTA_TOKENS_GLOBAL_DAY=210000
# en modo de ahorro, unas 3 preguntas más por conexión
QUOTA_TOKENS_IP_AHORRO=3600
# Google permite 15 por minuto: se deja margen, y una sola IP no se queda con más de un tercio
LLM_RPM_GLOBAL=13
LLM_RPM_POR_IP=4
# 3 preguntas en 30 s: una persona que lee las respuestas no llega ahí, y una sesión no puede pasar de 6 por minuto
SPIKE_MAX_REQUESTS=3
SPIKE_WINDOW_SECONDS=30
MAX_CONCURRENT_LLM=4
LLM_SLOT_WAIT_SECONDS=8
PRECIO_ENTRADA_USD_1M=0.30
PRECIO_SALIDA_USD_1M=2.50
