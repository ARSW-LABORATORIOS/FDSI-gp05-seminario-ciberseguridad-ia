# Se copia a infra/.env (no se sube a git). `python infra/crear_env.py` lo hace y genera los secretos.

# --- Secretos: se generan solos, no los compartas ---
SESSION_SECRET=
ALTCHA_HMAC_KEY=
LITELLM_MASTER_KEY=
GRAFANA_ADMIN_PASSWORD=

# --- Interruptores ---
# true: la interfaz pide la verificación ALTCHA antes de dejar preguntar. false: no pide nada.
CAPTCHA_ENABLED=true
# config.mock.yaml: LLM simulado (sin costo, sin GPU). Para un modelo real, usar perfiles/ (ver README).
LITELLM_CONFIG=config.mock.yaml
# Para usar Gemini (perfiles/gemini.env y python medir.py --modelo gemini). Nunca se sube a git.
GEMINI_API_KEY=

# --- Borde (nginx) ---
EDGE_RATE_PER_IP=10r/s
EDGE_BURST=20
EDGE_CONN_PER_IP=20

# --- Cuotas del gateway: valores para el LLM simulado. Con un modelo real, perfiles/ las reemplaza ---
QUOTA_TOKENS_SESSION=20000
QUOTA_TOKENS_IP_DAY=60000
QUOTA_TOKENS_GLOBAL_DAY=300000
SPIKE_MAX_REQUESTS=5
SPIKE_WINDOW_SECONDS=10
SESSIONS_PER_IP_HOUR=20
PROMPT_TOKEN_LIMIT=200
MAX_CONCURRENT_LLM=4
CACHE_SIMILARITY_THRESHOLD=0.90

# --- Orquestador ---
MAX_FRAGMENTOS=5
MAX_TOKENS_SALIDA=300
MAX_PASOS=4
DISTANCIA_MAX=0.78
MARGEN_RELEVANCIA=0.12
