500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  function currentTheme() {\r\n    const forced = document.documentElement.dataset.theme;\r\n    if (forced) return forced;\r\n    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';\r\n  }\r\n  function paintThemeBtn() {\r\n    const dark = currentTheme() === 'dark';\r\n    $('themeBtn').innerHTML = icon(dark ? 'sun' : 'moon', 18);\r\n    $('themeBtn').setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');\r\n  }\r\n  const savedTheme = store.get('theme');\r\n  if (savedTheme) document.documentElement.dataset.theme = savedTheme;\r\n  paintThemeBtn();\r\n  $('themeBtn').onclick = () => {\r\n    const next = currentTheme() === 'dark' ? 'light' : 'dark';\r\n    document.documentElement.dataset.theme = next;\r\n    store.set('theme', next);\r\n    paintThemeBtn();\r\n  };\r\n\r\n  // \u2500\u2500 barra lateral \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  $('subjects').innerHTML = SUBJECTS.map((s, i) => `\r\n    <div class=\"subject${i === 0 ? ' open' : ''}\" style=\"--c: var(--${s.key})\">\r\n      <button class=\"subject-head\" type=\"button\" aria-expanded=\"${i === 0}\">\r\n        <span class=\"subject-icon\">${icon(s.key)}</span>\r\n        <span class=\"name\">${esc(s.short || s.name)}</span>\r\n        <span class=\"chev\">${icon('chev', 14)}</span>\r\n      </button>\r\n      <div class=\"subject-docs\">\r\n        ${s.docs.map(([label, q]) => `<button class=\"doc-link\" type=\"button\" data-q=\"${esc(q)}\">${esc(label)}</button>`).join('')}\r\n      </div>\r\n    </div>`).join('');\r\n\r\n  $('subjects').addEventListener('click', e => {\r\n    const head = e.target.closest('.subject-head');\r\n    if (head) {\r\n      const box = head.parentElement;\r\n      box.classList.toggle('open');\r\n      head.setAttribute('aria-expanded', box.classList.contains('open'));\r\n      return;\r\n    }\r\n    const link = e.target.closest('.doc-link');\r\n    if (link) { closeNav(); send(link.dataset.q); }\r\n  });\r\n\r\n  const closeNav = () => document.body.classList.remove('nav-open');\r\n  $('menuBtn').onclick = () => document.body.classList.add('nav-open');\r\n  $('scrim').onclick = closeNav;\r\n  addEventListener('keydown', e => { if (e.key === 'Escape') closeNav(); });\r\n\r\n  // \u2500\u2500 bienvenida \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  function renderWelcome() {\r\n    started = false;\r\n    $('convTitle').textContent = 'Nueva conversaci\u00F3n';\r\n    thread.innerHTML = `\r\n      <section class=\"welcome\">\r\n        <span class=\"welcome-badge\">${icon('book', 14)} Base de conocimiento del curso</span>\r\n        <h3>\u00BFQu\u00E9 necesitas repasar hoy?</h3>\r\n        <p>Consulta el syllabus, los apuntes, talleres y gu\u00EDas de tus materias. Elige una para empezar o escribe tu pregunta abajo.</p>\r\n        <div class=\"cards\">\r\n          ${SUBJECTS.map(s => `\r\n            <button class=\"card\" type=\"button\" style=\"--c: var(--${s.key})\" data-q=\"${esc(s.docs[1][1])}\">\r\n              <span class=\"subject-icon\">${icon(s.key, 18)}</span>\r\n              <span><strong>${esc(s.short || s.name)}</strong><small>${esc(s.example)}</small></span>\r\n            </button>`).join('')}\r\n        </div>\r\n      </section>`;\r\n  }\r\n  thread.addEventListener('click', e => {\r\n    const card = e.target.closest('.card');\r\n    if (card) send(card.dataset.q);\r\n  });\r\n\r\n  // \u2500\u2500 formato de respuestas \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  function formatContent(contenido) {\r\n    const [title, ...lines] = contenido.split('\\n');\r\n    let html = `<h4>${esc(title)}</h4>`;\r\n    let list = [], grades = [], facts = [];\r\n    const flush = () => {\r\n      if (list.length) { html += `<ol>${list.map(li => `<li><span>${li}</span></li>`).join('')}</ol>`; list = []; }\r\n      if (grades.length) { html += `<div class=\"grades\">${grades.join('')}</div>`; grades = []; }\r\n    };\r\n    for (const raw of lines) {\r\n      const line = raw.trim();\r\n      if (!line) continue;\r\n      let m;\r\n      if ((m = line.match(/^Corte\\s+(\\d+)\\s*\\((\\d+%)\\):\\s*(.*)$/i))) {\r\n        if (list.length) flush();\r\n        grades.push(`<div class=\"grade\"><div><b>Corte ${esc(m[1])}</b><small>${esc(m[2])}</small></div><span>${esc(m[3])}</span></div>`);\r\n      } else if ((m = line.match(/^(?:\\d+\\.|Paso\\s+\\d+:)\\s*(.*)$/i))) {\r\n        if (grades.length) flush();\r\n        list.push(esc(m[1]));\r\n      } else if (line.includes(' | ')) {\r\n        flush();\r\n        facts.push(...line.split(' | ').map(part => {\r\n          const [k, ...v] = part.split(':');\r\n          return v.length ? `<span class=\"fact\"><b>${esc(k.trim())}:</b> ${esc(v.join(':').trim())}</span>` : `<span class=\"fact\">${esc(part)}</span>`;\r\n        }));\r\n      } else if ((m = line.match(/^([^:]{2,40}):\\s+(.+)$/))) {\r\n        flush();\r\n        html += `<p><strong>${esc(m[1])}:</strong> ${esc(m[2])}</p>`;\r\n      } else {\r\n        flush();\r\n        html += `<p>${esc(line)}</p>`;\r\n      }\r\n    }\r\n    flush();\r\n    if (facts.length) html += `<div class=\"facts\">${facts.join('')}</div>`;\r\n    return html;\r\n  }\r\n\r\n  // \u2500\u2500 mensajes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  function startThread() {\r\n    if (started) return;\r\n    started = true;\r\n    thread.innerHTML = '';\r\n  }\r\n\r\n  function addUser(text) {\r\n    const el = document.createElement('div');\r\n    el.className = 'msg user';\r\n    el.innerHTML = `<div class=\"msg-body\"><div class=\"bubble\">${esc(text)}</div><div class=\"meta\">${now()}</div></div>`;\r\n    thread.appendChild(el);\r\n    toBottom();\r\n  }\r\n\r\n  function botShell(inner) {\r\n    const el = document.createElement('div');\r\n    el.className = 'msg bot';\r\n    el.innerHTML = `\r\n      <div class=\"avatar\" aria-hidden=\"true\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 3 1 8l11 5 9-4.1V15h2V8L12 3Zm-6 9.3V16c0 1.9 2.7 4 6 4s6-2.1 6-4v-3.7l-6 2.7-6-2.7Z\"/></svg></div>\r\n      <div class=\"msg-body\"><div class=\"bot-name\">Asistente</div>${inner}</div>`;\r\n    thread.appendChild(el);\r\n    toBottom();\r\n    return el;\r\n  }\r\n\r\n  function addTyping() {\r\n    return botShell('<div class=\"typing\" aria-label=\"El asistente est\u00E1 escribiendo\"><i></i><i></i><i></i></div>');\r\n  }\r\n\r\n  function addAnswer(data) {\r\n    if (data.materia && data.contenido) {\r\n      const s = subjectByName(data.materia);\r\n      const key = s ? s.key : 'arq';\r\n      const el = botShell(`\r\n        <article class=\"answer\" style=\"--c: var(--${key})\">\r\n          <div class=\"answer-head\">\r\n            <span class=\"pill\">${icon(key, 13)} ${esc(s ? (s.short || s.name) : data.materia)}</span>\r\n            <span class=\"pill neutral\">${esc(data.tipo)}</span>\r\n          </div>\r\n          <div class=\"answer-body\">${formatContent(data.contenido)}</div>\r\n        </article>\r\n        <div class=\"meta\"><span>${now()}</span><span class=\"actions\"><button class=\"act\" type=\"button\">${icon('copy', 13)} Copiar</button></span></div>`);\r\n      const btn = el.querySelector('.act');\r\n      btn.onclick = async () => {\r\n        try {\r\n          await navigator.clipboard.writeText(data.contenido);\r\n          btn.innerHTML = `${icon('check', 13)} Copiado`;\r\n          setTimeout(() => { btn.innerHTML = `${icon('copy', 13)} Copiar`; }, 1600);\r\n        } catch {}\r\n      };\r\n    } else {\r\n      // respuesta sin documento (o backend viejo que solo manda \"answer\")\r\n      const text = data.answer || 'No obtuve respuesta del servidor.';\r\n      botShell(`<div class=\"bot-text\">${text.split('\\n').filter(Boolean).map(p => `<p>${bold(esc(p))}</p>`).join('')}</div><div class=\"meta\">${now()}</div>`);\r\n    }\r\n  }\r\n\r\n  function addError(retryText) {\r\n    const el = botShell(`\r\n      <div class=\"error-card\">${icon('alert', 18)}<span>No pude conectar con el servidor. Revisa que el backend siga corriendo.</span>\r\n      <button type=\"button\">Reintentar</button></div>`);\r\n    el.querySelector('button').onclick = () => { el.remove(); send(retryText, { silent: true }); };\r\n  }\r\n\r\n  async function send(text, { silent = false } = {}) {\r\n    const msg = (text ?? input.value).trim();\r\n    if (!msg || busy) return;\r\n    busy = true;\r\n    startThread();\r\n    if ($('convTitle').textContent === 'Nueva conversaci\u00F3n') {\r\n      $('convTitle').textContent = msg.length > 60 ? msg.slice(0, 57) + '\u2026' : msg;\r\n    }\r\n    if (!silent) addUser(msg);\r\n    if (text === undefined) { input.value = ''; autosize(); }\r\n    updateComposer();\r\n\r\n    const typing = addTyping();\r\n    const t0 = performance.now();\r\n    try {\r\n      const res = await fetch('/ask', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ message: msg }),\r\n      });\r\n      if (!res.ok) throw new Error(res.status);\r\n      const data = await res.json();\r\n      // pausa m\u00EDnima para que el indicador de escritura no parpadee\r\n      await new Promise(r => setTimeout(r, Math.max(0, 450 - (performance.now() - t0))));\r\n      typing.remove();\r\n      addAnswer(data);\r\n      setStatus(true);\r\n    } catch {\r\n      typing.remove();\r\n      addError(msg);\r\n      setStatus(false);\r\n    }\r\n    busy = false;\r\n    updateComposer();\r\n    input.focus();\r\n  }\r\n\r\n  // \u2500\u2500 caja de texto \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  function autosize() {\r\n    input.style.height = 'auto';\r\n    input.style.height = Math.min(input.scrollHeight, 160) + 'px';\r\n  }\r\n  function updateComposer() {\r\n    const n = input.value.length;\r\n    $('counter').textContent = `${n}/500`;\r\n    $('counter').classList.toggle('warn', n >= 450);\r\n    sendBtn.disabled = busy || !input.value.trim();\r\n  }\r\n  input.addEventListener('input', () => { autosize(); updateComposer(); });\r\n  input.addEventListener('keydown', e => {\r\n    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); send(); }\r\n  });\r\n  $('form').addEventListener('submit', e => { e.preventDefault(); send(); });\r\n  $('newChat').onclick = () => { closeNav(); renderWelcome(); input.focus(); };\r\n\r\n  // \u2500\u2500 estado del servidor \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n  function setStatus(ok) {\r\n    $('status').className = 'status ' + (ok ? 'ok' : 'down');\r\n    $('statusText').textContent = ok ? 'Servidor conectado' : 'Servidor sin conexi\u00F3n';\r\n  }\r\n  async function ping() {\r\n    try { setStatus((await fetch('/health', { cache: 'no-store' })).ok); } catch { setStatus(false); }\r\n  }\r\n\r\n  // en pantallas angostas el placeholder largo se parte en dos l\u00EDneas\r\n  const narrow = matchMedia('(max-width: 600px)');\r\n  const fitPlaceholder = () => {\r\n    input.placeholder = narrow.matches ? 'Escribe tu pregunta\u2026' : 'Pregunta por un syllabus, apuntes, taller o gu\u00EDa\u2026';\r\n  };\r\n  narrow.addEventListener('change', fitPlaceholder);\r\n  fitPlaceholder();\r\n\r\n  renderWelcome();\r\n  ping();\r\n  setInterval(ping, 20000);\r\n  input.focus();\r\n</script>",
